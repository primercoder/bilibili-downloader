# Batch and PowerShell files must keep CRLF line endings: cmd.exe and Windows
# PowerShell 5.1 expect them, and the .ps1 files are stored with a UTF-8 BOM.
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Shell scripts and Go sources stay LF.
*.sh            text eol=lf
*.go            text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# Binaries: never touch.
*.exe           binary
*.png           binary
*.zip           binary
*.tar.gz        binary
